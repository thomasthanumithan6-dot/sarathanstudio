# ------------------------------------------------------------------
# Sarathan Studio - environment variables
# Copy this file to ".env.local" and fill in your own values.
# NEVER commit .env.local or real secrets to version control.
# ------------------------------------------------------------------

# --- Supabase (authentication, database, private galleries) ---
# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used for privileged operations. NEVER expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Studio contact / WhatsApp booking ---
# Digits only, with country code (no +, spaces or dashes).
NEXT_PUBLIC_WHATSAPP_NUMBER=94776292002
# Human-readable phone number shown on the contact section.
NEXT_PUBLIC_STUDIO_PHONE=+94776292002

# --- AI photo preview and THOMA assistant ---
# Server-only. Used by /api/ai-preview and /api/thoma; never expose this key in the browser.
# The site works without it, but AI requests return a setup message.
OPENAI_API_KEY=
# Optional model used by THOMA's chat endpoint (defaults to gpt-4o-mini).
OPENAI_MODEL=gpt-4o-mini

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
